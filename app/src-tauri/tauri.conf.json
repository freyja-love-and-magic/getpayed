{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GetPayed",
  "version": "0.1.0",
  "identifier": "club.home.getpayed",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "GetPayed",
        "width": 390,
        "height": 844,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#F7F9FA"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [{"scheme": ["gelder"]}],
      "desktop": [{"schemes": ["gelder"]}]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "15.0",
      "developmentTeam": "PCUFMY9NKZ"
    }
  }
}
